# 复制为 .env 或直接在宿主机 export / 写入 docker-compose environment
# 应用启动时会读取 DATABASE_URL（见 module3/audit/models.py 中 load_dotenv）

DATABASE_URL=mysql+pymysql://用户:密码@主机:3306/security_audit?charset=utf8mb4

# 必选（多容器 / docker-compose）：全平台共用一对 SM2 密钥，否则各容器进程各自随机生成密钥，
# verify-chain 只能验证本进程签过的记录，跨服务写入会导致 valid=false。
# 生成： pip install gmssl && python module3/scripts/gen_audit_sm2_keys.py
AUDIT_SM2_PRIVATE_KEY=
AUDIT_SM2_PUBLIC_KEY=

# 默认写入 audit_log 的 account_id（与 seed 数据中 accounts.account_id 对齐）
# AUDIT_DEFAULT_ACCOUNT_ID=1

# --- 模块三：单机任务调度（controller 内）---
# SCHEDULER_MAX_CONCURRENT=2
# SCHEDULER_QUEUE_MAX=100
# controller 容器访问宿主机动态端口：默认 172.17.0.1；特殊网络可改 HOST_GATEWAY_IP
# 若 controller 不在 Docker 内跑动态任务，可设 SCHEDULER_DYNAMIC_USE_LOCALHOST=1

# --- 动态训练容器空闲回收（controller）---
# DYNAMIC_CONTAINER_IDLE_TIMEOUT_SECONDS=600
# DYNAMIC_CONTAINER_IDLE_MIN_LIFETIME_SECONDS=60
# DYNAMIC_CONTAINER_REAP_INTERVAL_SECONDS=30
# DYNAMIC_CONTAINER_IDLE_REAP_ENABLED=1

# 多容器并发写审计表时 MySQL 全局链锁名（默认即可）
# AUDIT_CHAIN_LOCK_NAME=cc_security_audit_chain
